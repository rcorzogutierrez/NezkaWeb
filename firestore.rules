rules_version = '2';

// Access model
// - A Firebase Auth account alone gives no access. Access comes from `users/{uid}`, which
//   only an administrator can write, with `active == true`.
// - The first administrator creates their own profile once, together with `settings/setup`.
// - Every collection not listed here is closed. Each new feature adds its own rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isActive() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isActive() && get(profilePath(request.auth.uid)).data.role == 'admin';
    }

    function validRole(role) {
      return role in ['admin', 'user'];
    }

    function validNewProfile(data) {
      return data.keys().hasOnly(['name', 'email', 'role', 'active', 'createdAt', 'createdBy',
          'mustChangePassword'])
        && data.keys().hasAll(['name', 'email', 'role', 'active', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.email is string && data.email.matches('^[^@\\s]+@[^@\\s]+$')
        && validRole(data.role)
        && data.active is bool
        && data.createdAt == request.time
        && (!('mustChangePassword' in data) || data.mustChangePassword is bool)
        && (!('createdBy' in data) || data.createdBy == request.auth.uid);
    }

    function setupPath() {
      return /databases/$(database)/documents/settings/setup;
    }

    // First run: no setup yet, this request creates it, and the profile is an active admin.
    function isFirstAdmin(uid) {
      return signedIn()
        && request.auth.uid == uid
        && !exists(setupPath())
        && existsAfter(setupPath())
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if validNewProfile(request.resource.data)
        && (isAdmin() || isFirstAdmin(uid));

      // Admins change name, role and active state. Nobody can demote or lock themselves out,
      // so there is always at least the admin making the change.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'active'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && validRole(request.resource.data.role)
        && request.resource.data.active is bool
        && (uid != request.auth.uid
          || (request.resource.data.role == 'admin' && request.resource.data.active == true));

      // After choosing their own password, a person clears the "temporary password" flag.
      // Only clearing it: nobody can switch it back on for themselves.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;

      // Admins remove someone else from the app (their sign-in stays in Firebase Auth, which
      // only the console or the Admin SDK can delete). Nobody deletes themselves, so the admin
      // doing it is always left. Estimates keep the author's id.
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Clients: every active user reads, creates and edits them; only administrators delete.
    function shortText(data, field, max) {
      return data[field] is string && data[field].size() <= max;
    }

    function validClient(data) {
      return data.keys().hasOnly(['name', 'branch', 'contactName', 'taxId', 'email', 'phone',
          'mobile', 'address', 'city', 'state', 'zipCode', 'country', 'notes', 'active',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && shortText(data, 'branch', 200)
        && shortText(data, 'contactName', 200)
        && shortText(data, 'taxId', 50)
        && shortText(data, 'email', 200)
        && (data.email == '' || data.email.matches('^[^@\\s]+@[^@\\s]+$'))
        && shortText(data, 'phone', 50)
        && shortText(data, 'mobile', 50)
        && shortText(data, 'address', 300)
        && shortText(data, 'city', 100)
        && shortText(data, 'state', 100)
        && shortText(data, 'zipCode', 20)
        && shortText(data, 'country', 100)
        && shortText(data, 'notes', 2000)
        && data.active is bool
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    match /clients/{clientId} {
      allow read: if isActive();
      allow create: if isActive()
        && validClient(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive()
        && validClient(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    // Products: every active user reads, creates and edits them; only administrators delete.
    function validProduct(data) {
      return data.keys().hasOnly(['ref', 'description', 'upc', 'size', 'pack', 'qtyPerPallet',
          'pricePerBox', 'pricePerUnit', 'notes', 'active', 'photoPath', 'photoUrl', 'photoThumb',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.description is string && data.description.size() > 0
        && data.description.size() <= 200
        && shortText(data, 'ref', 20)
        && shortText(data, 'upc', 40)
        && shortText(data, 'size', 60)
        && shortText(data, 'pack', 40)
        && shortText(data, 'qtyPerPallet', 40)
        && shortText(data, 'notes', 2000)
        && data.pricePerBox is number && data.pricePerBox >= 0 && data.pricePerBox < 1000000
        && (!('pricePerUnit' in data) || (data.pricePerUnit is number
          && data.pricePerUnit >= 0 && data.pricePerUnit < 1000000))
        && data.active is bool
        && shortText(data, 'photoPath', 300)
        && shortText(data, 'photoUrl', 1000)
        && (data.photoPath == '' || data.photoPath.matches('^products/[^/]+/[^/]+$'))
        && (!('photoThumb' in data) || (shortText(data, 'photoThumb', 40000)
          && (data.photoThumb == ''
            || data.photoThumb.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))))
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if isActive();
      allow create: if isActive()
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive()
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    // Estimates (proformas): every active user reads, creates and edits them; only
    // administrators delete. Lines are a list of product snapshots; the app checks each line.
    function validEstimate(data) {
      return data.keys().hasOnly(['number', 'clientId', 'clientName', 'clientBranch', 'date',
          'reference', 'status', 'notes', 'lines', 'totalBoxes', 'total',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.number is string && data.number.size() > 0 && data.number.size() <= 30
        && data.clientId is string && data.clientId.size() > 0
        && exists(/databases/$(database)/documents/clients/$(data.clientId))
        && shortText(data, 'clientName', 200)
        && shortText(data, 'clientBranch', 200)
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && shortText(data, 'reference', 200)
        && data.status in ['draft', 'sent', 'accepted', 'rejected']
        && shortText(data, 'notes', 2000)
        && data.lines is list && data.lines.size() > 0 && data.lines.size() <= 300
        && data.totalBoxes is int && data.totalBoxes > 0
        && data.total is number && data.total >= 0
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    match /estimates/{estimateId} {
      allow read: if isActive();
      allow create: if isActive()
        && validEstimate(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive()
        && validEstimate(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /settings/setup {
      // The login page asks whether the first administrator still has to be created.
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['admin', 'createdAt'])
        && request.resource.data.admin == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(profilePath(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }
  }
}
