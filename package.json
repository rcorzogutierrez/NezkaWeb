{
  "name": "nezkaweb",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "emulators": "firebase emulators:start --only auth,functions,firestore,storage --project demo-nezka",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "test:functions": "npm --prefix functions test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test:ci && npm run test:functions && npm run test:rules && npm run build",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,storage",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-nezka-rules \"vitest run --config vitest.rules.config.mts\""
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@lucide/angular": "^1.78.0",
    "firebase": "^13.4.0",
    "jspdf": "4.2.1",
    "read-excel-file": "9.3.14",
    "rxjs": "~7.8.0",
    "sql.js": "1.15.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/sql.js": "1.4.9",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
